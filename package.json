{
  "name": "@kubohiroya/turbowarp-block-editor",
  "version": "0.0.0",
  "private": true,
  "description": "Framework-independent editor sessions for TurboWarp extension blocks",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubohiroya/turbowarp-block-editor.git"
  },
  "bugs": {
    "url": "https://github.com/kubohiroya/turbowarp-block-editor/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./rjsf": {
      "types": "./dist/rjsf.d.ts",
      "import": "./dist/rjsf.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./react/styles.css": "./dist/react.css",
    "./turbowarp": {
      "types": "./dist/turbowarp.d.ts",
      "import": "./dist/turbowarp.js"
    },
    "./webpack4": {
      "require": "./webpack4.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "docs",
    "webpack4.cjs"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --project tsconfig.json && node scripts/copy-react-css.mjs && node scripts/build-webpack4.mjs",
    "test": "pnpm build && node --test test/*.test.mjs",
    "test:e2e:block-editor": "playwright test --config test/e2e/turbowarp/playwright.config.cjs",
    "test:e2e:infrastructure": "node --test test/e2e/turbowarp/infrastructure.test.cjs",
    "test:e2e:native": "E2E_NATIVE=1 pnpm test:e2e:block-editor"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@turbowarp/jszip": "3.11.1",
    "@types/react": "^16.14.70",
    "@types/react-dom": "^16.9.25",
    "esbuild": "0.28.2",
    "jsdom": "26.1.0",
    "react": "16.14.0",
    "react-dom": "16.14.0",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@rjsf/core": "5.24.13",
    "@rjsf/utils": "5.24.13",
    "@rjsf/validator-ajv8": "5.24.13",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "react": "^16.14.0 || ^17 || ^18",
    "react-dom": "^16.14.0 || ^17 || ^18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
