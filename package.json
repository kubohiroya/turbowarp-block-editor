{
  "name": "@kubohiroya/turbowarp-block-editor",
  "version": "0.0.0",
  "private": true,
  "description": "Framework-independent editor sessions for TurboWarp extension blocks",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubohiroya/turbowarp-block-editor.git"
  },
  "bugs": {
    "url": "https://github.com/kubohiroya/turbowarp-block-editor/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./rjsf": {
      "types": "./dist/rjsf.d.ts",
      "import": "./dist/rjsf.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --project tsconfig.json",
    "test": "pnpm build && node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@types/react": "^16.14.70",
    "@types/react-dom": "^16.9.25",
    "jsdom": "26.1.0",
    "react": "16.14.0",
    "react-dom": "16.14.0",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@rjsf/core": "5.24.13",
    "@rjsf/utils": "5.24.13",
    "@rjsf/validator-ajv8": "5.24.13",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "react": "^16.14.0 || ^17 || ^18",
    "react-dom": "^16.14.0 || ^17 || ^18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
